{
  "name": "lumilan-chat",
  "version": "1.1.0",
  "description": "Pesan langsung antarperangkat di jaringan lokal",
  "author": "Iyan Sanjaya",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "smoke:ui": "node scripts/smoke-ui.cjs",
    "smoke:notch": "node scripts/smoke-notch.cjs",
    "pack": "electron-builder --dir --publish never",
    "dist": "electron-builder --publish never",
    "release": "node scripts/prepare-release.mjs && electron-builder --publish always"
  },
  "build": {
    "appId": "dev.lumilan.desktop",
    "productName": "Lumilan Chat",
    "asar": true,
    "asarUnpack": ["**/node_modules/sharp/**/*", "**/node_modules/@img/**/*"],
    "files": [
      "main.js",
      "notch.js",
      "linux-screen-lock.js",
      "notch-preload.cjs",
      "startup-default.js",
      "updates.js",
      "preload.cjs",
      "peer.js",
      "reminders.js",
      "preview-image.js",
      "clipboard-image.js",
      "discovery.js",
      "public/**/*",
      "build/icon.ico",
      "build/icon.png",
      "build/trayTemplate*.png",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "iyansanjaya",
      "repo": "lumilan-chat",
      "releaseType": "draft"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "mac": {
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon-mac.icns",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Lumilan Chat memerlukan mikrofon saat Anda menerima atau memulai panggilan suara."
      }
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    }
  },
  "dependencies": {
    "@libp2p/crypto": "5.1.23",
    "@libp2p/identify": "4.1.14",
    "@libp2p/noise": "17.0.3",
    "@libp2p/peer-id": "6.0.15",
    "@libp2p/tcp": "11.0.28",
    "@libp2p/yamux": "8.0.3",
    "@multiformats/multiaddr": "13.0.3",
    "electron-updater": "^6.8.9",
    "libp2p": "3.3.11",
    "multicast-dns": "7.2.5",
    "reicon": "1.2.4",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  }
}
