{
  "name": "lumilan-chat",
  "version": "1.2.0",
  "description": "Pesan langsung antarperangkat di jaringan lokal",
  "author": "Iyan Sanjaya",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "out/main.js",
  "scripts": {
    "start": "bun run build && electron .",
    "build": "bun scripts/build.ts",
    "typecheck": "bun scripts/build.ts check",
    "test": "bun scripts/build.ts test",
    "test:large": "bun scripts/build.ts large",
    "verify:package": "node out/scripts/verify-ui-package.cjs",
    "smoke:ui": "node out/scripts/smoke-ui.cjs",
    "smoke:notch": "node out/scripts/smoke-notch.cjs",
    "pack": "bun run build && electron-builder --dir --publish never",
    "dist": "bun run build && electron-builder --publish never",
    "release": "bun run build && node out/scripts/prepare-release.mjs && electron-builder --publish always"
  },
  "build": {
    "appId": "dev.lumilan.desktop",
    "productName": "Lumilan Chat",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/sharp/**/*",
      "**/node_modules/@img/**/*"
    ],
    "files": [
      "out/main.js",
      "out/notch.js",
      "out/linux-screen-lock.js",
      "out/notch-preload.cjs",
      "out/startup-default.js",
      "out/updates.js",
      "out/preload.cjs",
      "out/peer.js",
      "out/reminders.js",
      "out/preview-image.js",
      "out/clipboard-image.js",
      "out/discovery.js",
      "out/shared/model.js",
      "out/public/**/*",
      "!out/**/*.map",
      "out/build/icon.ico",
      "out/build/icon.png",
      "out/build/trayTemplate*.png",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "iyansanjaya",
      "repo": "lumilan-chat",
      "releaseType": "draft"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "mac": {
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon-mac.icns",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Lumilan Chat memerlukan mikrofon saat Anda menerima atau memulai panggilan suara."
      }
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    }
  },
  "dependencies": {
    "@libp2p/crypto": "5.1.23",
    "@libp2p/identify": "4.1.14",
    "@libp2p/noise": "17.0.3",
    "@libp2p/peer-id": "6.0.15",
    "@libp2p/tcp": "11.0.28",
    "@libp2p/yamux": "8.0.3",
    "@multiformats/multiaddr": "13.0.3",
    "electron-updater": "^6.8.9",
    "libp2p": "3.3.11",
    "main-event": "1.0.5",
    "multicast-dns": "7.2.5",
    "reicon": "1.2.4",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/multicast-dns": "7.2.4",
    "@types/node": "22.20.5",
    "@types/semver": "7.8.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "typescript": "6.0.2"
  }
}
